# ─── PostgreSQL (AWS RDS / Local) ────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=steamdb

# ─── MongoDB (Analytics & Event Pipeline) ────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=steam_analytics

# ─── Redis (Cache / Pub-Sub) ─────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY_HOURS=24

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── AI Engine (Python FastAPI) ──────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000

# ─── Object Storage (AWS S3 or Local MinIO) ──────────────────────────────────
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=steam-assets
S3_GAME_COVERS_PREFIX=steam/game-covers/
S3_AVATARS_PREFIX=steam/avatars/
# For Local MinIO (leave empty for real AWS S3 in production):
AWS_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_URL is used by browser/frontend to access images (e.g. http://localhost:9000):
S3_PUBLIC_URL=http://localhost:9000
